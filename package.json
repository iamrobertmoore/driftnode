{
  "name": "driftnode-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace root for driftnode and the nodes it generates.",
  "license": "MIT",
  "author": "Robert Moore",
  "engines": { "node": ">=20.19" },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "conformance": "npm run conformance --workspace packages/n8n-nodes-vultr --if-present"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^2.1.4",
    "@types/node": "^22.9.0"
  }
}

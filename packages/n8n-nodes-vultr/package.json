{
  "name": "n8n-nodes-vultr",
  "version": "0.1.0",
  "description": "n8n community node for Vultr API",
  "keywords": [
    "n8n-community-node-package",
    "vultr"
  ],
  "license": "MIT",
  "homepage": "/Users/robertmoore/projects/Hackathons/ready-spec-ship/repo/examples/vultr-api-docs.html",
  "repository": {
    "type": "git",
    "url": ""
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "usableAsTool": true,
    "credentials": [
      {
        "className": "VultrApi",
        "sourcePath": "dist/credentials/VultrApi.credentials.js"
      }
    ],
    "nodes": [
      {
        "className": "Vultr",
        "sourcePath": "dist/nodes/Vultr/Vultr.node.js"
      }
    ]
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "n8n-workflow": "^1.0.0",
    "n8n-core": "^1.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  }
}
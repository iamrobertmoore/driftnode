{
  "name": "n8n-nodes-vultr",
  "version": "0.1.4",
  "description": "n8n community node for Vultr API",
  "keywords": [
    "n8n-community-node-package",
    "vultr"
  ],
  "license": "MIT",
  "author": "Robert Moore",
  "homepage": "https://www.vultr.com/api/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/iamrobertmoore/driftnode.git"
  },
  "files": [
    "dist",
    "contract",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').cpSync('nodes','dist/nodes',{recursive:true,filter:s=>!s.endsWith('.ts')})\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "conformance": "vitest run test/conformance.test.ts"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/VultrApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Vultr/Vultr.node.js"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "n8n-workflow": "^2.16.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
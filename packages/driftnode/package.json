{
  "name": "driftnode",
  "version": "0.1.0",
  "description": "Turns prose API documentation into a publishable n8n community node, with a conformance test that fails CI when the upstream API drifts.",
  "license": "MIT",
  "author": "Robert Moore",
  "keywords": ["n8n", "n8n-community-node", "code-generation", "api", "conformance", "kiro"],
  "engines": { "node": ">=20.19" },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": { "driftnode": "dist/cli.js" },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}

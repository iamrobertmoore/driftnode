{
  "vendor": "vultr",
  "documentation": {
    "type": "file",
    "path": "./vultr-api-docs.html"
  },
  "auth": {
    "type": "bearer_token",
    "header_name": "Authorization"
  },
  "include": [
    {
      "resource": "regions",
      "operations": ["list"]
    },
    {
      "resource": "plans",
      "operations": ["list"]
    },
    {
      "resource": "ssh-keys",
      "operations": ["list", "get", "create", "update", "delete"]
    },
    {
      "resource": "instances",
      "operations": ["list", "get", "create", "delete", "reboot"]
    }
  ]
}

{
  "vendor": "vultr",
  "documentation": {
    "type": "file",
    "path": "./vultr-api-docs.html"
  },
  "auth": {
    "type": "bearer_token",
    "header_name": "Authorization"
  },
  "packageMeta": {
    "version": "0.1.3",
    "author": "Robert Moore",
    "repository": "git+https://github.com/iamrobertmoore/driftnode.git",
    "homepage": "https://www.vultr.com/api/",
    "license": "MIT"
  },
  "include": [
    {
      "resource": "regions",
      "operations": ["list-regions"]
    },
    {
      "resource": "plans",
      "operations": ["list-plans"]
    },
    {
      "resource": "ssh-keys",
      "operations": [
        "list-ssh-keys",
        "get-ssh-key",
        "create-ssh-key",
        "update-ssh-key",
        "delete-ssh-key"
      ]
    },
    {
      "resource": "instances",
      "operations": [
        "list-instances",
        "get-instance",
        "create-instance",
        "delete-instance",
        "reboot-instance",
        "halt-instance",
        "start-instance"
      ]
    }
  ]
}
